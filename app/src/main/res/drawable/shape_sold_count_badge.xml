<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Linear gradient: left (sky_200) -> right (lighter / near-white). Center color set to sky_200 so the color spreads further right -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/sky_200"
        android:centerColor="@color/sky_100"
        android:endColor="#E6FFFFFF" />

    <!-- Corner radius similar to border-radius: 16px in CSS -->
    <corners android:radius="6dp" />

    <!-- Subtle semi-transparent border to simulate the CSS border: 1px solid rgba(255,255,255,0.3) -->
    <stroke android:width="1dp" android:color="#4DFFFFFF" />

</shape>