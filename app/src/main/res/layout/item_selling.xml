<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginVertical="5dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/cart_card_background">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_seller_product_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/necklace" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_seller_product_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:text="Ladies necklace with pendant"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/item_seller_product_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ladies 24Kt gold necklace with pendant."
                android:textSize="10sp"
                android:textColor="@color/md_theme_outline"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/montserrat_medium"
                android:maxLines="1"
                android:ellipsize="end"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/item_seller_product_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="LKR 324000.00"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/item_seller_product_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textSize="8sp"
                    android:gravity="center_vertical"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/sky_500"
                    android:background="@drawable/shape_view_certificate_btn"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp" />


            </LinearLayout>



        </LinearLayout>

    </LinearLayout>


</com.google.android.material.card.MaterialCardView>