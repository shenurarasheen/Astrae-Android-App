<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:src="@drawable/necklace" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold"
                android:maxLines="1"
                android:text="Ladies necklace with pendant"
                android:textSize="15sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24Kt"
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserrat_semibold"
                    android:background="@drawable/shape_badge"
                    android:paddingHorizontal="3dp"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Necklace"
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserrat_semibold"
                    android:background="@drawable/shape_badge"
                    android:paddingHorizontal="3dp"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendant"
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserrat_semibold"
                    android:background="@drawable/shape_badge"
                    android:paddingHorizontal="3dp"
                    android:layout_marginEnd="4dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="LKR 324000.00"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Qty : 2"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_semibold"/>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Shipping : LKR 2000.00"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shipping"
                    android:textSize="10sp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/sky_500"
                    android:background="@drawable/shape_view_certificate_btn"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="3dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


</com.google.android.material.card.MaterialCardView>