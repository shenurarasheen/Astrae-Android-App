<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.SellerProductsActivity">

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back_arrow" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="Selling Products"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Revenue within week"
        android:fontFamily="@font/montserrat_semibold"
        android:textSize="17sp"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="15dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selling_products_chart_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="15dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your selling products"
        android:fontFamily="@font/montserrat_semibold"
        android:textSize="18sp"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="15dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/selling_products_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="10dp"/>

</LinearLayout>