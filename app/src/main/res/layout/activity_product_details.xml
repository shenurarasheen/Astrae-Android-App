    <FrameLayout
        android:id="@+id/single_product_back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:background="@drawable/shape_single_product_back_btn"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/back2"
            app:tint="@color/white" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_btn_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/shape_single_product_button_footer"
        android:paddingVertical="16dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/single_product_add_to_cart_btn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Add to cart"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_semibold"
            android:backgroundTint="@color/btn_blue"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/single_product_buy_now_btn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Buy now"
            android:textColor="@color/btn_blue"
            app:strokeColor="@color/btn_blue"
            app:strokeWidth="1.3dp" />

    </LinearLayout>

</RelativeLayout>