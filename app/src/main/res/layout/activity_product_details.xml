<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_btn_panel">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/product_viewpager"
                android:layout_width="match_parent"
                android:layout_height="360dp" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dots_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                app:dotsColor="@color/sky_200"
                app:dotsCornerRadius="8dp"
                app:dotsSize="8dp"
                app:dotsSpacing="4dp"
                app:progressMode="true"
                app:selectedDotColor="@color/sky_500" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/single_product_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat_semibold"
                    android:maxLines="2"
                    android:text="Women stylish gold necklace with pendant"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/single_product_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat_medium"
                    android:maxLines="4"
                    android:text="Women'S Stylish Pendant Necklace Featuring a Easy And Elegant Design with Faux Zinc Alloy Pendant, Perfect for Vacations And Everyday Wear"
                    android:textSize="13sp" />


                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/single_product_badge_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                </com.google.android.flexbox.FlexboxLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_sold_count_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_spv_flame" />

                        <TextView
                            android:id="@+id/single_product_sold_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="Sold 20+"
                            android:textColor="@color/sky_500"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="|  Sold by"
                            android:textSize="11sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/single_product_seller"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/shape_circle_image"
                            android:padding="4dp"
                            android:src="@drawable/img_default_profile"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text=">"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="4.5"
                            android:textColor="#eab308"
                            android:textSize="12sp" />

                        <RatingBar
                            android:id="@+id/single_product_rating"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progressTint="#eab308"
                            android:rating="4.5" />

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/single_product_estimate_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="9947.74"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Est."
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="LKR"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/single_product_real_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="9520.30"
                        android:textSize="20sp" />
                </LinearLayout>


                <!--Quantity input-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Qty"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_quantity_selector"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp">

                            <TextView
                                android:id="@+id/single_product_minus_qty_btn"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:fontFamily="@font/montserrat_semibold"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="@color/sky_400"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/single_product_qty"
                                android:layout_width="34dp"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/montserrat_bold"
                                android:gravity="center"
                                android:text="1"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/single_product_plus_qty_btn"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:fontFamily="@font/montserrat_semibold"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@color/sky_400"
                                android:textSize="18sp" />
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="30dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/single_product_view_certificate_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/shape_view_certificate_btn"
                                android:fontFamily="@font/montserrat_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="7dp"
                                android:text="View Certificate ›"
                                android:textColor="@color/sky_500"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:letterSpacing="0.02"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/md_theme_inverseOnSurface_mediumContrast" />

            <include
                android:id="@+id/similar_product_items_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                layout="@layout/item_single_product_similar_section"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <FrameLayout
        android:id="@+id/single_product_back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/shape_single_product_back_btn"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/back2"
            app:tint="@color/white" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_btn_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/shape_single_product_button_footer"
        android:paddingHorizontal="10dp"
        android:paddingVertical="16dp"
        android:clipChildren="false">

        <Button
            android:id="@+id/single_product_add_to_cart_btn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/btn_blue"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Add to cart"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/single_product_buy_now_btn"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Buy now"
            android:textColor="@color/btn_blue"
            app:strokeColor="@color/btn_blue"
            app:strokeWidth="1.3dp" />

    </LinearLayout>

</RelativeLayout>