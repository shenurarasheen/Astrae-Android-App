<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_btn_panel">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/product_viewpager"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/necklace"/>

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dots_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                app:dotsColor="@color/sky_200"
                app:dotsSize="8dp"
                app:dotsSpacing="4dp"
                app:dotsCornerRadius="8dp"
                app:selectedDotColor="@color/sky_500"
                app:progressMode="true"
                />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Women stylish gold necklace with pendant"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Women'S Stylish Pendant Necklace Featuring a Easy And Elegant Design with Faux Zinc Alloy Pendant, Perfect for Vacations And Everyday Wear"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="4"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24Kt"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:background="@drawable/shape_badge"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="@color/white"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ladies"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:background="@drawable/shape_badge"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="@color/white"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Necklace"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:background="@drawable/shape_badge"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="@color/white"
                        android:layout_marginEnd="6dp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:background="@drawable/shape_sold_count_badge">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_spv_flame"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sold 20+"
                            android:textSize="11sp"
                            android:textColor="@color/sky_500"
                            android:fontFamily="@font/montserrat_medium"
                            android:layout_marginStart="3dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|  Sold by"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_medium"/>

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:padding="4dp"
                            android:src="@drawable/img_default_profile"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/shape_circle_image"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text=">"
                            android:textSize="16sp"
                            android:fontFamily="@font/montserrat_semibold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:layout_marginStart="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.5"
                            android:textSize="12sp"
                            android:textColor="#eab308"
                            android:layout_marginEnd="5dp"
                            android:fontFamily="@font/montserrat_semibold"/>

                        <RatingBar
                            android:id="@+id/single_product_rating"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:rating="4.5"
                            android:progressTint="#eab308" />

                    </LinearLayout>

                </LinearLayout>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp">

                    <TextView
                        android:id="@+id/single_product_estimate_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="9947.74"
                        android:textSize="22sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est."
                        android:layout_marginStart="6dp"
                        android:textSize="16sp"
                        android:fontFamily="@font/montserrat_semibold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LKR"
                        android:layout_marginStart="10dp"
                        android:textSize="17sp"
                        android:fontFamily="@font/montserrat_semibold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9520.30"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_semibold"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>


                <!--Quantity input-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_semibold"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/decrement_qty_btn"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:textAlignment="center"
                            android:text="-"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_semibold"/>

                        <TextView
                            android:id="@+id/single_product_qty"
                            android:layout_width="30dp"
                            android:layout_height="match_parent"
                            android:text="1"
                            android:gravity="center"
                            android:fontFamily="@font/montserrat_semibold"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/increment_qty_btn"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:textAlignment="center"
                            android:text="+"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_semibold"/>


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="30dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View Certificate >"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:textColor="@color/sky_400"
                                android:background="@drawable/shape_view_certificate_btn"
                                android:paddingVertical="5dp"
                                android:paddingHorizontal="6dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FloatingActionButton placed above the ViewPager2 (top-end). Aligns to the NestedScrollView top so it overlays the top child (the ViewPager) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:fabCustomSize="50dp"
        android:layout_alignTop="@id/main_scroll"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:maxImageSize="24dp"
        app:srcCompat="@drawable/back2"
        android:scaleType="center"
        app:shapeAppearanceOverlay="@style/CircleImage"
        android:background="@drawable/shape_back_btn"
        app:backgroundTint="@color/md_theme_secondaryContainer" />

    <LinearLayout
        android:id="@+id/bottom_btn_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/cart_price_background"
        android:paddingVertical="16dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal">

        <Button
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Add to cart"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_semibold"
            android:backgroundTint="@color/btn_blue"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>

        <Button
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Buy now"
            android:textColor="@color/btn_blue"
            app:strokeColor="@color/btn_blue"
            app:strokeWidth="1.3dp" />

    </LinearLayout>

</RelativeLayout>