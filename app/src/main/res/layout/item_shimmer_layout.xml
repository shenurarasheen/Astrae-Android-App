<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/shimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.6"
        app:shimmer_colored="false"
        app:shimmer_duration="1300"
        app:shimmer_highlight_alpha="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <!--  ══════════ CARD 1 ══════════  -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!--  Image area: light background (like a real white product photo)  -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="155dp"
                        android:background="@drawable/shimmer_image_area">
                        <!--  Cart icon: medium grey circle — visible on light bg  -->
                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/shimmer_circle" />
                    </FrameLayout>
                    <!--  Dark info section  -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="14dp">
                        <!--  Title line 1  -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="13dp"
                            android:layout_marginBottom="7dp"
                            android:background="@drawable/shimmer_rect_r6" />
                        <!--  Title line 2 (shorter)  -->
                        <View
                            android:layout_width="105dp"
                            android:layout_height="13dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/shimmer_rect_r6" />
                        <!--  Chip row  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="46dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/shimmer_chip" />

                            <View
                                android:layout_width="65dp"
                                android:layout_height="22dp"
                                android:background="@drawable/shimmer_chip" />
                        </LinearLayout>
                        <!--  "PRICE" label  -->
                        <View
                            android:layout_width="36dp"
                            android:layout_height="9dp"
                            android:layout_marginBottom="7dp"
                            android:background="@drawable/shimmer_rect_r6" />
                        <!--  Price + Buy row  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <!--  "LKR" stub  -->
                                <View
                                    android:layout_width="26dp"
                                    android:layout_height="9dp"
                                    android:layout_marginBottom="5dp"
                                    android:background="@drawable/shimmer_rect_r6" />
                                <!--  Amount stub  -->
                                <View
                                    android:layout_width="72dp"
                                    android:layout_height="15dp"
                                    android:background="@drawable/shimmer_rect_r6" />
                            </LinearLayout>
                            <!--  Buy button pill  -->
                            <View
                                android:layout_width="74dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shimmer_button_pill" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--  ══════════ CARD 2 ══════════  -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="155dp"
                        android:background="@drawable/shimmer_image_area">

                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/shimmer_circle" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="14dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="13dp"
                            android:layout_marginBottom="7dp"
                            android:background="@drawable/shimmer_rect_r6" />

                        <View
                            android:layout_width="88dp"
                            android:layout_height="13dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/shimmer_rect_r6" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/shimmer_chip" />

                            <View
                                android:layout_width="68dp"
                                android:layout_height="22dp"
                                android:background="@drawable/shimmer_chip" />
                        </LinearLayout>

                        <View
                            android:layout_width="36dp"
                            android:layout_height="9dp"
                            android:layout_marginBottom="7dp"
                            android:background="@drawable/shimmer_rect_r6" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="26dp"
                                    android:layout_height="9dp"
                                    android:layout_marginBottom="5dp"
                                    android:background="@drawable/shimmer_rect_r6" />

                                <View
                                    android:layout_width="72dp"
                                    android:layout_height="15dp"
                                    android:background="@drawable/shimmer_rect_r6" />
                            </LinearLayout>

                            <View
                                android:layout_width="74dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shimmer_button_pill" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>
