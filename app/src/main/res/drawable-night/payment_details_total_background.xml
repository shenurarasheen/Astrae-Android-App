<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="10dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#0F212121"/> <!-- subtle dark-gray shadow for night theme -->
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- main glassy background: darkened for night mode -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC212121"/> <!-- semi-opaque dark gray -->
            <!--            <stroke android:width="1dp" android:color="#66FFFFFF"/>-->
            <corners android:topRightRadius="30dp" android:topLeftRadius="30dp"/>
        </shape>
    </item>
</layer-list>